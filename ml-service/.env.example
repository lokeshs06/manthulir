# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Security ----
# Must match ML_SERVICE_INTERNAL_KEY in the Node API's .env
INTERNAL_API_KEY=changeme-internal-key

# ---- Model ----
# When true, /predict returns deterministic fake predictions from labels.json
# without loading any real model. Lets the Node API be built/tested before
# a model is trained.
# A real model is trained and checked in: MobileNetV3-Large, 16 tomato
# classes (8 leaf diseases + healthy from PlantVillage, 8 insect pests from
# a Mendeley Data tomato-pest dataset). 95.23% overall test accuracy, but
# macro-F1 is only 84.04% — the insect classes (24-131 training images each,
# vs 373-5357 for diseases) drag it down, especially the three caterpillar
# species that get confused with each other. See
# ml-service/training/EXPERIMENT_NOTES.md for the full honest breakdown.
MOCK_MODEL=false
MODEL_PATH=artifacts/model.torchscript.pt
LABELS_PATH=artifacts/labels.json
MODEL_VERSION=tomato-disease-pest-2026-09-22

MAX_UPLOAD_MB=5
