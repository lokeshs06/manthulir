# ---- Server ----
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# ---- Database ----
# MongoDB Atlas connection string (or local mongodb://mongo:27017/manthulir for docker-compose)
MONGODB_URI=mongodb://localhost:27017/manthulir

# ---- Auth ----
# Use long, random, unrelated secrets for access vs refresh tokens
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- CORS ----
# Comma-separated list of allowed origins. The Vite frontend defaults to
# :5173 in dev, :4173 for its production preview — in production, set this
# to your actual deployed frontend origin (e.g. https://your-site.netlify.app).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=changeme
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme

# ---- ML Service ----
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_INTERNAL_KEY=changeme-internal-key
ML_CONFIDENCE_THRESHOLD=0.70

# ---- Admin seed credentials ----
SEED_ADMIN_NAME=Manthulir Admin
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=changeme-admin-password

# ---- WhatsApp (optional final phase) ----
# Verify token you choose and enter into the Meta App Dashboard webhook config
WHATSAPP_VERIFY_TOKEN=changeme-verify-token
# App secret, used to verify the X-Hub-Signature-256 header on incoming webhooks
WHATSAPP_APP_SECRET=changeme-app-secret
# Permanent/system-user access token for the WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=changeme-access-token
# The "Phone number ID" (not the phone number itself) from the Meta App Dashboard
WHATSAPP_PHONE_NUMBER_ID=changeme-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v20.0

# ---- Logging ----
LOG_LEVEL=info
